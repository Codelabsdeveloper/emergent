# Database
# Local default: SQLite file (no Docker required)
DATABASE_URL="file:./dev.db"
# Production example (PostgreSQL):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/emergent

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_MAX_AGE_MS=28800000

# Initial admin bootstrap (used by prisma seed only)
ADMIN_USERNAME=Emergent
ADMIN_PASSWORD=Password1

# Frontend (Vite)
VITE_API_BASE_URL=/api
