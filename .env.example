# Database (PostgreSQL — required)
# Local example (matches docker-compose.yml):
DATABASE_URL=postgresql://emergent:emergent_dev_password@localhost:5432/emergent
# Render: use the Internal Database URL from your Render PostgreSQL service

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
SESSION_MAX_AGE_MS=28800000

# Initial admin bootstrap (used by prisma seed only — does not overwrite existing admin password)
ADMIN_USERNAME=Emergent
ADMIN_PASSWORD=Password1

# Frontend (Vite)
# Local: /api (Vite proxy)
# Netlify production: https://YOUR-RENDER-URL/api
VITE_API_BASE_URL=/api
